# FreshHire API — PRODUCTION settings. Copy to ".env.production" (ignored by Git) and fill in.
# Every value below is a placeholder. Never commit the real file.
#
# Who reads this file:
#   - "npm run start:prod" and "npm run seed:prod" on your own computer.
#   - NOT Vercel. On Vercel, add the same keys under Project → Settings → Environment Variables.

NODE_ENV=production

# The LIVE database (MongoDB Atlas). Use a different database name than your local one
# (e.g. /freshhire for live, /freshhire_dev in server/.env) so testing never changes live data.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/freshhire?retryWrites=true&w=majority

# Signs login tokens: 32+ random characters. Use the SAME value here and in Vercel only if you want
# tokens to be valid on both; otherwise any long random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value-of-at-least-32-characters

JWT_EXPIRES_IN=2h
APP_TIMEZONE_OFFSET_MINUTES=330

# Other sites allowed to call the API. Leave unset on Vercel (pages and API share one domain).
# Set it only to open the pages from Live Server against "npm run start:prod":
# FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500

# Keep false: true lets an admin erase the whole live database.
ALLOW_DEMO_RESET=false
