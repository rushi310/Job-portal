# FreshHire API — copy this file to ".env" for local development.
# Never commit the real .env file. Every value below is a placeholder.

# "development" locally, "production" on Render.
NODE_ENV=development

# Port the API listens on. Render sets PORT itself; do not set it there.
PORT=5000

# MongoDB connection string.
# Local MongoDB:  mongodb://127.0.0.1:27017/freshhire
# Atlas:          mongodb+srv://<db-user>:<db-password>@<cluster-host>/freshhire?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/freshhire

# Secret used to sign login tokens. Use a long random value (32+ characters), e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

# How long a login token stays valid.
JWT_EXPIRES_IN=2h

# Comma-separated list of OTHER origins allowed to call the API (no trailing slash, no wildcard).
# Local (pages on Live Server):          http://localhost:5500,http://127.0.0.1:5500
# Vercel (pages and API on one domain):  leave it unset — same-origin requests need no permission
# Split hosting (e.g. Netlify + Render): https://your-site-name.netlify.app
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500

# Deadlines end at midnight in this time zone (minutes ahead of UTC; 330 = India Standard Time).
APP_TIMEZONE_OFFSET_MINUTES=330

# Failed logins, and registrations, allowed per IP address in each 15-minute window.
AUTH_RATE_LIMIT_MAX=20

# Local development only: also serve the static frontend from http://localhost:5000 (true / false).
SERVE_FRONTEND=false

# Lets the admin "Reset demo data" button erase the database and re-import the demo data.
# Keep this false on any database that holds data you care about.
ALLOW_DEMO_RESET=false

# Seed script only. Required when NODE_ENV=production: the password given to the seeded admin account.
# Leave it out of this file; set it only in the shell that runs the seed command.
# SEED_ADMIN_PASSWORD=
